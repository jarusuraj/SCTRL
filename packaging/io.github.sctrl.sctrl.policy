<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>SCTRL Contributors</vendor>
  <vendor_url>https://github.com/sctrl/sctrl</vendor_url>

  <action id="io.github.sctrl.sctrl.read">
    <description>Read hardware telemetry and diagnostics</description>
    <message>Authentication is not required to read hardware telemetry.</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.sctrl.sctrl.write">
    <description>Modify fan mode, performance profile, or battery limit</description>
    <message>Authentication is required to adjust hardware controls.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.sctrl.sctrl.admin">
    <description>Enable experimental hardware overrides or model profile modifications</description>
    <message>Administrator authentication is required for advanced hardware configuration.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

</policyconfig>
